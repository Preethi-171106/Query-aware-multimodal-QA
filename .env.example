# ==============================================================================
# Environment Configuration Template
# Copy this file to '.env' and fill in the required API keys and settings.
# WARNING: NEVER commit your actual '.env' file or secret keys into source control!
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development

# LLM / VLM API Settings
# Get your Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding & Cross-Encoder Model Choices
TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32

# Device Configuration: 'cpu' or 'cuda' (auto-selects cuda if available)
DEVICE=cpu

# Data & Storage Directories
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
EXTRACTED_DIR=./data/extracted
INDEX_DIR=./data/indices
